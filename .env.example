# Copy to .env.local for local development and add the same values in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# API key from https://resend.com/api-keys (server-only, never prefix with NEXT_PUBLIC_)
RESEND_API_KEY=
# Where contact messages are delivered (comma-separate multiple addresses)
CONTACT_TO_EMAIL=
# Sender. Must use a domain verified in Resend, e.g. "Portfolio <contact@yourdomain.com>".
# For testing only, "Portfolio <onboarding@resend.dev>" works but can only deliver
# to the email address of your Resend account.
CONTACT_FROM_EMAIL=

# ── Rate limiting (Upstash Redis) ──────────────────────────────────────────────
# Strongly recommended in production. Without these, a per-instance in-memory
# limiter is used, which serverless instances do not share.
# The Vercel Marketplace Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN,
# which are also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Site ───────────────────────────────────────────────────────────────────────
# Canonical URL used for SEO metadata, e.g. https://divyabhogle.com
# Falls back to the Vercel production URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
